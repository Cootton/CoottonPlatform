{
  "name": "@cootton/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "verify:media": "node verification/media.cjs",
    "verify": "node --test verification/cache.cjs verification/publication.cjs verification/media.cjs verification/video.cjs verification/firebase-media.cjs verification/http-contract.cjs verification/web-http.cjs",
    "verify:db": "node --test verification/measurement-db.cjs",
    "dev": "pnpm build && node dist/main.js",
    "start": "node dist/main.js",
    "db:check": "node --env-file=.env dist/check-database.js",
    "catalog:migrate": "node --env-file=.env dist/catalog-migrate.js",
    "start:catalog": "node --env-file=.env.catalog dist/main.js",
    "catalog:verify": "node --env-file=.env.catalog dist/catalog-verify.js"
  },
  "dependencies": {
    "@cootton/contracts": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "firebase-admin": "14.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
