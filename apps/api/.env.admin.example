# Never commit actual connection values or Firebase credentials.
# Existing public SELECT-only catalog reader; never use maintenance owner.
DATABASE_URL=
# Separate scoped writer, never fallback to DATABASE_URL or cootton_owner.
ADMIN_DATABASE_URL=
FIREBASE_PROJECT_ID=cootton-firebase
# Use actual ADC workload/local identity; no Firebase emulator or fake token.
# GOOGLE_APPLICATION_CREDENTIALS references a private local file only if needed.
HOST=127.0.0.1
PORT=3001
