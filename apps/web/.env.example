# Backend-only API origin. Never put DATABASE_URL in the Web environment.
CATALOG_API_ORIGIN=http://127.0.0.1:3001
ADMIN_API_ORIGIN=http://127.0.0.1:3001
ADMIN_WEB_ORIGIN=http://127.0.0.1:3000
# Public Firebase application options, read by the server at runtime.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_AUTH_DOMAIN=cootton-firebase.firebaseapp.com
